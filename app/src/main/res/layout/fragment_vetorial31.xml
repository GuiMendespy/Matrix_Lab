<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cônicas: Circunferência"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nDefinição Geométrica"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="A circunferência é o conjunto de todos os pontos de um plano que estão a uma mesma distância r (raio) de um ponto fixo C (centro). É o caso particular da elipse onde os focos coincidem." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nVisualização Geométrica"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A73E8" />

        <WebView
            android:id="@+id/math_circ_visualizacao"
            android:layout_width="match_parent"
            android:layout_height="280dp" />

        <WebView
            android:id="@+id/math_eq_circunferencia"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="Diagrama de Circunferência"
            android:src="@drawable/unidade3_1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nExemplos e Exercícios Resolvidos"
            android:textSize="18sp"
            android:textStyle="bold" />

        <WebView
            android:id="@+id/math_ex_circunferencia"
            android:layout_width="match_parent"
            android:layout_height="180dp" />

        <WebView
            android:id="@+id/math_mais_ex_circ"
            android:layout_width="match_parent"
            android:layout_height="400dp" />

        <View android:layout_width="match_parent" android:layout_height="80dp" />
    </LinearLayout>
</ScrollView>