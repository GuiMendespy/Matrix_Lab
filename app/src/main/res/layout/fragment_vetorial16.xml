<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.reflow.Vetorial16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Produto Misto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="Dados os vetores u, v e w, tomados nesta ordem, chama-se produto misto ao número real obtido pelo produto escalar do primeiro pelo produto vetorial dos outros dois:" />

        <WebView
            android:id="@+id/math_def_misto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@android:color/transparent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="O produto misto pode ser calculado diretamente através do determinante das componentes dos três vetores:" />

        <WebView
            android:id="@+id/math_det_misto"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@android:color/transparent" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="16dp"
            android:src="@drawable/exemplo18" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="16dp"
            android:src="@drawable/exemplo19" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#EDE7F6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Experimente no Simulador 3D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#512DA8"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="v₁ = (2.0, 3.0, 5.0)&#10;v₂ = (-1.0, 3.0, 3.0)&#10;v₃ = (4.0, -3.0, 2.0)&#10;Misto(v₁, v₂, v₃) = ?"
                    android:textSize="14sp"
                    android:textColor="#37474F"
                    android:fontFamily="monospace"
                    android:paddingBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simulador_misto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▶  Ver Produto Misto"
                    android:tag="(2.0,3.0,5.0); (-1.0,3.0,3.0); (4.0,-3.0,2.0); misto 1 2 3"
                    app:backgroundTint="#673AB7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>
