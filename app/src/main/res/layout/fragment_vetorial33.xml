<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cônicas: Hipérbole"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nDefinição e Assíntotas"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="A hipérbole é o lugar geométrico dos pontos do plano cuja diferença das distâncias a dois pontos fixos (focos) em valor absoluto é constante e igual a 2a." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nVisualização Geométrica"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A73E8" />

        <WebView
            android:id="@+id/math_hiperbole_visualizacao"
            android:layout_width="match_parent"
            android:layout_height="260dp" />

        <WebView
            android:id="@+id/math_eq_hiperbole"
            android:layout_width="match_parent"
            android:layout_height="320dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nRelação Pitagórica"
            android:textSize="18sp"
            android:textStyle="bold" />

        <WebView
            android:id="@+id/math_rel_hiperbole"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nExercícios Resolvidos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A73E8" />

        <WebView
            android:id="@+id/math_ex_resolvidos_33"
            android:layout_width="match_parent"
            android:layout_height="420dp" />

        <View android:layout_width="match_parent" android:layout_height="80dp" />
    </LinearLayout>
</ScrollView>