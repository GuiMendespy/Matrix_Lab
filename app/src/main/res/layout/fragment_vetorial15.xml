<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.reflow.Vetorial15">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Produto Vetorial"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="Chama-se produto vetorial de dois vetores u e v, representados por u x v, ao vetor obtido conforme a definição analítica abaixo:" />

        <WebView
            android:id="@+id/math_def_vetorial"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@android:color/transparent" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/produtovetorial_concerto_1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="A equação acima pode ser obtida através do desenvolvimento pelo Teorema de Laplace, substituindo-se os coeficientes pelos vetores unitários i, j e k. Este fato sugere a utilização de um determinante simbólico para facilitar a memorização:" />

        <WebView
            android:id="@+id/math_determinante_simbolico"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@android:color/transparent" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="8dp"
            android:src="@drawable/exemplo17" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="12dp"
            android:src="@drawable/produtovetorial_concerto_2" />

        <!-- Card link para o Simulador -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#EDE7F6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Experimente no Simulador 3D"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#512DA8"
                    android:paddingBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="v₁ = (5.0, 4.0, 3.0)&#10;v₂ = (1.0, 0.0, 1.0)&#10;v₁ × v₂ = ?"
                    android:textSize="14sp"
                    android:textColor="#37474F"
                    android:fontFamily="monospace"
                    android:paddingBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_simulador_vetorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▶  Ver Produto Vetorial"
                    android:tag="(5.0,4.0,3.0); (1.0,0.0,1.0); vetorial 1x2"
                    app:backgroundTint="#673AB7" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp" />

    </LinearLayout>
</ScrollView>