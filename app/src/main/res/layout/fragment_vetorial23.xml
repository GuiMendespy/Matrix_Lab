<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.reflow.Vetorial23">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posições Relativas e Paralelogramos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n1. Equação Vetorial de um Paralelogramo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/exemplo31" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="Dados três pontos A, B e C não colineares, eles determinam um plano e, especificamente, dois vetores AB e AC. O paralelogramo formado por esses vetores pode ser descrito por uma combinação linear onde os coeficientes variam entre 0 e 1 (Figura 6.8). " />

        <WebView
            android:id="@+id/math_eq_paralelogramo"
            android:layout_width="match_parent"
            android:layout_height="100dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/concertodeposicoes2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n2. Ângulos entre Elementos"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O ângulo entre dois planos é o ângulo entre seus vetores normais. O ângulo entre uma reta e um plano é o complementar do ângulo entre o vetor diretor da reta e o vetor normal do plano (Figura 6.17)."
            android:textSize="16sp" />

        <WebView
            android:id="@+id/math_angulo_planos"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/concertoposicoes1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n3. Interseções e Posições Relativas"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uma reta pode estar contida no plano, ser paralela a ele ou interceptá-lo em um único ponto. (Figura 6.20)"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/unidade2_15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nExercícios Resolvidos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A73E8" />

        <WebView
            android:id="@+id/math_ex_resolvidos_23"
            android:layout_width="match_parent"
            android:layout_height="400dp" />

        <View android:layout_width="match_parent" android:layout_height="80dp" />
    </LinearLayout>
</ScrollView>