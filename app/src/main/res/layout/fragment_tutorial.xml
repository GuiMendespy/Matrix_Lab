<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Cabeçalho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guia Oficial MatrixLab"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sua jornada completa em Álgebra Linear e Vetorial começa aqui."
            android:textSize="16sp"
            android:layout_marginBottom="24dp"
            android:textColor="#5F6368"/>

        <!-- Seção 1: Agente Inteligente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Agente de IA (Tutor Pessoal)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#202124"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dúvidas complexas? O nosso Agente integrado utiliza IA para explicar conceitos passo a passo e geração de questões. Acesse pelo ícone de chat no menu principal."
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Seção 2: Banco Teórico e Questões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Banco Teórico"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#202124"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estude a base teórica de matrizes, sistemas e vetores. Com a possibilidade de exemplos ilustrativos no simulador."
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Seção 3: Simulador 3D -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Simulador Vetorial e Linear"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#202124"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visualize vetores e transformações no espaço tridimensional. Acesse o ícone de 'Cubo' no menu inferior (direita) para abrir a ferramenta de visualização."
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Navegação -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Como Navegar?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Menu Inferior: Alterna entre Estudos, Simulador e Agente Pessoal.\n• Tela Inicial: Clique em 'Começar' para abrir o mapa de estudos.\n• Lateral: Use o menu lateral para informações e ajuda."
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Logo IFPB -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:src="@drawable/logo_ifpb_campina_grande"
            android:contentDescription="IFPB"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp"
            android:alpha="0.8"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desenvolvido para o IFPB - Campus Campina Grande"
            android:layout_gravity="center"
            android:textSize="12sp"
            android:textColor="#9AA0A6"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>