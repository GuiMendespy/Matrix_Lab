<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Superfícies Quádricas"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nDefinição Geral"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:justificationMode="inter_word"
            android:text="Uma superfície quádrica é o lugar geométrico dos pontos (x, y, z) do espaço que satisfazem uma equação do segundo grau a três variáveis. Elas são a extensão tridimensional das cônicas." />

        <WebView
            android:id="@+id/math_eq_quadrica"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nClassificação e Estudo das Quádricas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A73E8" />

        <!-- 1. Elipsoide -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n1. Elipsoide"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="É uma superfície onde todas as seções planas são elipses (ou circunferências). Se a=b=c, temos uma esfera."
            android:textSize="15sp" />
        <WebView
            android:id="@+id/img_elipsoide"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
        <WebView
            android:id="@+id/math_elipsoide"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <!-- 2. Hiperboloide de 1 Folha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n2. Hiperboloide de uma Folha"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uma superfície contínua que possui seções elípticas paralelas ao plano principal e seções hiperbólicas nos outros planos."
            android:textSize="15sp" />
        <WebView
            android:id="@+id/img_hiperboloide1"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
        <WebView
            android:id="@+id/math_hiperboloide1"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <!-- 3. Hiperboloide de 2 Folhas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n3. Hiperboloide de duas Folhas"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Composta por duas superfícies separadas. Não existe interseção com o plano central entre as folhas."
            android:textSize="15sp" />
        <WebView
            android:id="@+id/img_hiperboloide2"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
        <WebView
            android:id="@+id/math_hiperboloide2"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <!-- 4. Paraboloide Elíptico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n4. Paraboloide Elíptico"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Superfície em formato de tigela ou cúpula. As seções horizontais são elipses e as verticais são parábolas."
            android:textSize="15sp" />
        <WebView
            android:id="@+id/img_paraboloide_elip"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
        <WebView
            android:id="@+id/math_paraboloide_elip"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <!-- 5. Paraboloide Hiperbólico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n5. Paraboloide Hiperbólico (Sela)"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conhecida como sela de cavalo. Possui curvaturas em direções opostas."
            android:textSize="15sp" />
        <WebView
            android:id="@+id/img_paraboloide_hiper"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
        <WebView
            android:id="@+id/math_paraboloide_hiper"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <!-- 6. Cone de 2ª Ordem -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n6. Cone de Segunda Ordem"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Superfície cônica que converge em um único ponto (vértice)."
            android:textSize="15sp" />
        <WebView
            android:id="@+id/img_cone"
            android:layout_width="match_parent"
            android:layout_height="220dp" />
        <WebView
            android:id="@+id/math_cone"
            android:layout_width="match_parent"
            android:layout_height="350dp" />

        <View android:layout_width="match_parent" android:layout_height="80dp" />
    </LinearLayout>
</ScrollView>